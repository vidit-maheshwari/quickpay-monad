{
  "name": "backend",
  "version": "1.0.0",
  "description": "Express backend service",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
  "dev": "concurrently \"tsx watch src/index.ts\" \"tsx watch src/payment-service.ts\"",
  "dev:payment": "tsx watch src/payment-service.ts",
  "dev:all": "concurrently \"tsx watch src/index.ts\" \"tsx watch src/payment-service.ts\"",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.21.1",
    "@supabase/supabase-js": "^2.80.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "ethers": "^6.15.0",
    "express": "^4.21.2",
    "node-fetch": "^3.3.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "bs58": "^6.0.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
